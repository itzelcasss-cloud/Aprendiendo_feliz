#listo
view(pheno_gse_188915)


md_pheno_gse_188915 <- pheno_gse_188915 |>
  select( c(geo_accession,
            'hormonal medication:ch1',
            source_name_ch1,
            title))

md_pheno_gse_188915$title_2 <- colnames(conteo_gse_188915)


view(md_pheno_gse_188915)

md_pheno_gse_188915 <- md_pheno_gse_188915 |> 
  mutate(`hormonal medication:ch1` = factor(`hormonal medication:ch1`))

md_pheno_gse_188915$`hormonal medication:ch1` <- relevel(md_pheno_gse_188915$`hormonal medication:ch1`, ref = "None")

design_gse188915 <- model.matrix(~ 0 + md_pheno_gse_188915$`hormonal medication:ch1`)
colnames(design_gse188915) <- c(
  "Mirena",
  "None",
  "OCP"
)

design_gse188915 <- model.matrix(~ 0 + md_pheno_gse_188915$`hormonal medication:ch1`)

conteo_gse_188915 <- conteo_gse_188915[,md_pheno_gse_188915$title_2]
all(colnames(conteo_gse_188915) == md_pheno_gse_188915$title_2)

colnames(design_gse188915) <- make.names(colnames(design_gse188915))

fit_gse188915 <- lmFit(conteo_gse_188915, design_gse188915)

contraste_gse188915 <- makeContrasts(
  md_pheno_gse_188915..hormonal.medication.ch1.None - md_pheno_gse_188915..hormonal.medication.ch1.Mirena - md_pheno_gse_188915..hormonal.medication.ch1.OCP,
  levels = design_gse188915)

fit2_gse188915 <- contrasts.fit(fit_gse188915, contraste_gse188915)
fit2_gse188915 <- eBayes(fit2_gse188915)

#resultados 
resultados_gse188915 <- topTable(
  fit2_gse188915,
  coef = 1,
  number = Inf,
  adjust.method = "BH"
)

#genes diferencilmente expresados 
deg_gse188915 <- resultados_gse188915[
  resultados_gse188915$adj.P.Val <0.1 &
    abs(resultados_gse188915$logFC) >=1.5,]

resultados_gse188915$significativo <- "No significativo"

resultados_gse188915$significativo[
  resultados_gse188915$adj.P.Val < 0.1 &
    resultados_gse188915$logFC >= 1.5
] <- "Sobreexpresado"

resultados_gse188915$significativo[
  resultados_gse188915$adj.P.Val < 0.1 &
    resultados_gse188915$logFC <= -1.5
] <- "Subexpresado"

ggplot(resultados_gse188915, aes(
  x = logFC,
  y = -log10(adj.P.Val),
  color = significativo
)) +
  geom_point(alpha = 0.6, size = 1.5) +
  geom_vline(xintercept = c(-1, 1),
             linetype = "dashed") +
  geom_hline(yintercept = -log10(0.05),
             linetype = "dashed") +
  labs(
    title = "Volcano Plot",
    x = "log2 Fold Change",
    y = "-log10(FDR)",
    color = "Clasificación"
  ) +
  theme_minimal()
